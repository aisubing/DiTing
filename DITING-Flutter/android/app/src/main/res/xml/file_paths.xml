<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path
        name="app_update"
        path="app-update/" />
    <files-path
        name="crash_logs"
        path="crash_logs/" />
    <external-files-path
        name="crash_export"
        path="Download/" />
    <!--
        O-125: CrashLogManager.exportToPrivateDownloads falls back to
        File(filesDir, "downloads") when getExternalFilesDir() is unavailable
        (external storage not mounted / emulated user). Without this mapping
        FileProvider.getUriForFile() throws IllegalArgumentException, so the
        already written backup file is reported as a failure and stays orphaned
        in filesDir forever. Keep in sync with CrashLogManager.PRIVATE_DOWNLOAD_DIR_NAME.
    -->
    <files-path
        name="crash_export_private"
        path="downloads/" />
</paths>
